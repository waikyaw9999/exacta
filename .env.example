# Copy this file to `.env` and replace local defaults before deploying.
# Never commit real secrets.

POSTGRES_DB=exacta
POSTGRES_USER=exacta
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432

SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/exacta
SPRING_DATASOURCE_USERNAME=exacta
SPRING_DATASOURCE_PASSWORD=change-me-in-production
JWT_SECRET=replace-with-a-256-bit-secret-key-for-production
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://127.0.0.1:5173,http://127.0.0.1:3000

APP_SEED_ENABLED=true
APP_SEED_ADMIN_EMAIL=ada@exacta.test
APP_SEED_ADMIN_PASSWORD=ExactaDemo1!
APP_SEED_MEMBER_PASSWORD=ExactaDemo1!

FRONTEND_PORT=3000
VITE_API_BASE_URL=/api/v1
